# Which API to use: "openai" (default) or "openrouter"
LLM_PROVIDER="openai"

# API key for the selected provider (only the one you use is required)
OPENAI_API_KEY="xxxxx"
OPENROUTER_API_KEY="xxxxx"

# Optional: default model (defaults to gpt-5.6-luna, or openai/gpt-5.6-luna on OpenRouter)
# LLM_MODEL="gpt-5.6-luna"

# Optional: number of recent messages sent to the model each turn (default 20)
# MAX_HISTORY_MESSAGES="20"
